{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monster Control Center",
  "version": "1.0.1",
  "identifier": "com.monster.controlcenter",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Monster Control Center",
        "width": 1020,
        "height": 680,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Monster Control Center for Linux",
    "longDescription": "Keyboard RGB and EC Control for Monster / Tongfang Laptops",
    "resources": {
      "driver/tuxedo-drivers-monster-4.25.0": "/usr/src/tuxedo-drivers-monster-4.25.0"
    },
    "linux": {
      "rpm": {
        "desktopTemplate": "packaging/desktop.template",
        "depends": [
          "dkms",
          "kernel-devel",
          "gcc",
          "make"
        ],
        "postInstallScript": "packaging/rpm-postinstall.sh",
        "preRemoveScript": "packaging/rpm-preremove.sh"
      },
      "deb": {
        "desktopTemplate": "packaging/desktop.template"
      }
    }
  }
}
