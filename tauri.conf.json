{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tuxeren-control-center",
  "version": "1.1.3",
  "identifier": "org.txectrl.tcc",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tuxeren Control Center",
        "width": 1020,
        "height": 680,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "license": "GPL-3.0-or-later",
    "targets": [
      "deb",
      "appimage",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Tuxeren Control Center (TxeCtrl) for Linux",
    "longDescription": "Hardware, Keyboard RGB and EC Control for Uniwill / Tongfang Laptops",
    "resources": {
      "driver/tuxedo-drivers-monster-4.25.0": "/usr/src/tuxedo-drivers-monster-4.25.0"
    },
    "linux": {
      "rpm": {
        "desktopTemplate": "packaging/desktop.template",
        "depends": [
          "dkms",
          "kernel-devel",
          "gcc",
          "make"
        ],
        "files": {
          "/usr/share/metainfo/tuxeren-control-center.metainfo.xml": "packaging/tuxeren-control-center.metainfo.xml",
          "/usr/share/swcatalog/xml/tuxeren-control-center.xml": "packaging/tuxeren-control-center.swcatalog.xml",
          "/usr/share/pixmaps/tuxeren-control-center.png": "icons/256x256.png",
          "/usr/share/pixmaps/txectrl-gui.png": "icons/256x256.png",
          "/usr/share/icons/hicolor/256x256/apps/tuxeren-control-center.png": "icons/256x256.png",
          "/usr/share/icons/hicolor/256x256/apps/txectrl-gui.png": "icons/256x256.png",
          "/usr/share/icons/hicolor/128x128/apps/tuxeren-control-center.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/128x128/apps/txectrl-gui.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/64x64/apps/tuxeren-control-center.png": "icons/64x64.png",
          "/usr/share/icons/hicolor/64x64/apps/txectrl-gui.png": "icons/64x64.png",
          "/usr/share/icons/hicolor/32x32/apps/tuxeren-control-center.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/scalable/apps/tuxeren-control-center.svg": "icons/tuxeren-control-center.svg"
        },
        "postInstallScript": "packaging/rpm-postinstall.sh",
        "preRemoveScript": "packaging/rpm-preremove.sh"
      },
      "deb": {
        "desktopTemplate": "packaging/desktop.template",
        "files": {
          "/usr/share/metainfo/tuxeren-control-center.metainfo.xml": "packaging/tuxeren-control-center.metainfo.xml",
          "/usr/share/swcatalog/xml/tuxeren-control-center.xml": "packaging/tuxeren-control-center.swcatalog.xml",
          "/usr/share/pixmaps/tuxeren-control-center.png": "icons/256x256.png",
          "/usr/share/pixmaps/txectrl-gui.png": "icons/256x256.png",
          "/usr/share/icons/hicolor/256x256/apps/tuxeren-control-center.png": "icons/256x256.png",
          "/usr/share/icons/hicolor/256x256/apps/txectrl-gui.png": "icons/256x256.png",
          "/usr/share/icons/hicolor/128x128/apps/tuxeren-control-center.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/128x128/apps/txectrl-gui.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/64x64/apps/tuxeren-control-center.png": "icons/64x64.png",
          "/usr/share/icons/hicolor/64x64/apps/txectrl-gui.png": "icons/64x64.png",
          "/usr/share/icons/hicolor/32x32/apps/tuxeren-control-center.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/scalable/apps/tuxeren-control-center.svg": "icons/tuxeren-control-center.svg"
        }
      }
    }
  }
}
